{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "rootDir": "./src/",
    "outDir": "./dist/",
    "strict": true,
    "moduleResolution": "node16",
    "importHelpers": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "typeRoots": ["node_modules/@types"],
    "sourceMap": false
  },
  "files": ["./src/index.ts"],
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "dist", "register.ts", "prisma.config.ts"]
}
