    "discord.js": "^14.26.4",
    "fastify": "^5.8.5",
    "loglevel": "^1.9.2",
    "node-fetch": "3.3.2",
    "password-generator": "^3.0.0",
    "prisma": "^7.8.0",
    "proxy-agent": "^8.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/config": "^3.3.5",
    "@types/node": "^25.6.2",
    "@types/node-fetch": "^3.0.2",
    "typescript": "^6.0.3"
  },
  "nodemonConfig": {
    "ignore": [
      ".cache/**/*",
      "scratch/**/*"
    ]
  }
