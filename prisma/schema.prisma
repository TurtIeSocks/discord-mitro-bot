datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id              Int     @id @default(autoincrement())
  discord_id      String?
  github_username String?
  amount          Int     @default(0)
  main_endpoint   String?
  backup_endpoint String?
  active          Boolean @default(false)

  @@map("user")
}
